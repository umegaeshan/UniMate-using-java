<?xml version="1.0" encoding="utf-8"?>
<!-- Used for the slider tutorial screens before login -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBEFF2">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="20dp"
        android:padding="5dp"
        android:src="@android:drawable/ic_media_previous"
        app:tint="#000000" />

    <!-- Centered content block holding the changing images and text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome UniMate"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Your Tasks"
            android:textColor="#333333"
            android:textSize="18sp"
            android:layout_marginBottom="25dp"/>

        <!-- White card background to make the illustrations pop out nicely -->
        <androidx.cardview.widget.CardView
            android:layout_width="280dp"
            android:layout_height="280dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="30dp">

            <ImageView
                android:id="@+id/imgOnboarding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:padding="15dp"
                android:background="#FFFFFF"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add your daily tasks easily.\nWrite them down so you do not forget anything important."
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginHorizontal="20dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:paddingHorizontal="40dp"
        android:paddingVertical="12dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0B192C"
        app:cornerRadius="25dp"/>

</RelativeLayout>